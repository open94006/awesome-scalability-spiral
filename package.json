    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "unpdf": "^1.8.1"
  }
}
